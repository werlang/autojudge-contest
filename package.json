{
  "name": "autojudge-contest",
  "displayName": "AutoJudge Contest",
  "description": "Read problems, export public tests, submit solutions, and follow verdicts and live standings of AutoJudge contests inside VS Code.",
  "version": "0.2.0",
  "publisher": "autojudge",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education",
    "Testing",
    "Other"
  ],
  "keywords": [
    "autojudge",
    "contest",
    "competitive programming",
    "online judge",
    "icpc",
    "judge",
    "education",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/werlang/autojudge-contest"
  },
  "bugs": {
    "url": "https://github.com/werlang/autojudge-contest/issues"
  },
  "scripts": {
    "build": "vsce package",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "homepage": "https://autojudge.io",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b2934",
    "theme": "dark"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onCommand:autojudgeContest.loginTeam",
    "onCommand:autojudgeContest.logoutTeam",
    "onCommand:autojudgeContest.refreshTree",
    "onCommand:autojudgeContest.openContestDashboard",
    "onCommand:autojudgeContest.openProblem",
    "onCommand:autojudgeContest.submitActiveFile",
    "onCommand:autojudgeContest.exportPublicCases",
    "onCommand:autojudgeContest.openSubmission",
    "onCommand:autojudgeContest.openTeamStanding",
    "onCommand:autojudgeContest.compareSubmissionOutput",
    "onView:autojudgeContest.explorer",
    "onView:autojudgeContest.teams"
  ],
  "type": "module",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "autojudgeContest",
          "title": "AutoJudge Contest",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "autojudgeContest": [
        {
          "id": "autojudgeContest.explorer",
          "name": "Contest Explorer",
          "icon": "media/icon.svg"
        },
        {
          "id": "autojudgeContest.teams",
          "name": "Standings",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "autojudgeContest.explorer",
        "contents": "Log in with your team to see the contest problems and your submissions.\n[Log In with Browser](command:autojudgeContest.loginTeam)\nYour browser opens the AutoJudge team login. Enter the team code and PIN from your team card.",
        "when": "autojudgeContest.state == loggedOut"
      },
      {
        "view": "autojudgeContest.explorer",
        "contents": "Loading the contest…",
        "when": "autojudgeContest.state == loading"
      },
      {
        "view": "autojudgeContest.explorer",
        "contents": "Could not reach the AutoJudge server. Your session is kept.\n[Retry](command:autojudgeContest.refreshTree)\nCheck your connection or the [API URL setting](command:workbench.action.openSettings?%22autojudgeContest.baseUrl%22).",
        "when": "autojudgeContest.state == offline"
      },
      {
        "view": "autojudgeContest.teams",
        "contents": "Log in to follow the live contest standings.\n[Log In with Browser](command:autojudgeContest.loginTeam)",
        "when": "autojudgeContest.state == loggedOut"
      },
      {
        "view": "autojudgeContest.teams",
        "contents": "Loading the contest…",
        "when": "autojudgeContest.state == loading"
      },
      {
        "view": "autojudgeContest.teams",
        "contents": "Could not reach the AutoJudge server. Your session is kept.\n[Retry](command:autojudgeContest.refreshTree)\nCheck your connection or the [API URL setting](command:workbench.action.openSettings?%22autojudgeContest.baseUrl%22).",
        "when": "autojudgeContest.state == offline"
      }
    ],
    "commands": [
      {
        "command": "autojudgeContest.loginTeam",
        "title": "Log In",
        "category": "AutoJudge Contest",
        "icon": "$(sign-in)"
      },
      {
        "command": "autojudgeContest.logoutTeam",
        "title": "Log Out",
        "category": "AutoJudge Contest",
        "icon": "$(sign-out)"
      },
      {
        "command": "autojudgeContest.refreshTree",
        "title": "Refresh",
        "category": "AutoJudge Contest",
        "icon": "$(refresh)"
      },
      {
        "command": "autojudgeContest.openContestDashboard",
        "title": "Open Contest Overview",
        "category": "AutoJudge Contest",
        "icon": "$(dashboard)"
      },
      {
        "command": "autojudgeContest.openProblem",
        "title": "Open Problem Statement",
        "category": "AutoJudge Contest",
        "icon": "$(book)"
      },
      {
        "command": "autojudgeContest.submitActiveFile",
        "title": "Submit Active File…",
        "category": "AutoJudge Contest",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "autojudgeContest.exportPublicCases",
        "title": "Export Public Test Cases",
        "category": "AutoJudge Contest",
        "icon": "$(beaker)"
      },
      {
        "command": "autojudgeContest.openSubmission",
        "title": "Open Submission",
        "category": "AutoJudge Contest",
        "icon": "$(history)"
      },
      {
        "command": "autojudgeContest.openTeamStanding",
        "title": "Open Team Details",
        "category": "AutoJudge Contest",
        "icon": "$(organization)"
      },
      {
        "command": "autojudgeContest.compareSubmissionOutput",
        "title": "Compare Expected and Received Output",
        "category": "AutoJudge Contest",
        "icon": "$(diff)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "autojudgeContest.refreshTree",
          "when": "view == autojudgeContest.explorer && autojudgeContest.state != loggedOut && autojudgeContest.state != loading",
          "group": "navigation@1"
        },
        {
          "command": "autojudgeContest.logoutTeam",
          "when": "view == autojudgeContest.explorer && autojudgeContest.state != loggedOut && autojudgeContest.state != loading",
          "group": "9_session@1"
        },
        {
          "command": "autojudgeContest.refreshTree",
          "when": "view == autojudgeContest.teams && autojudgeContest.state != loggedOut && autojudgeContest.state != loading",
          "group": "navigation@1"
        },
        {
          "command": "autojudgeContest.logoutTeam",
          "when": "view == autojudgeContest.teams && autojudgeContest.state != loggedOut && autojudgeContest.state != loading",
          "group": "9_session@1"
        }
      ],
      "view/item/context": [
        {
          "command": "autojudgeContest.openProblem",
          "when": "view == autojudgeContest.explorer && viewItem == autojudgeContest.problem",
          "group": "inline@1"
        },
        {
          "command": "autojudgeContest.exportPublicCases",
          "when": "view == autojudgeContest.explorer && viewItem == autojudgeContest.problem",
          "group": "inline@2"
        },
        {
          "command": "autojudgeContest.submitActiveFile",
          "when": "view == autojudgeContest.explorer && viewItem == autojudgeContest.problem",
          "group": "inline@3"
        },
        {
          "command": "autojudgeContest.openProblem",
          "when": "view == autojudgeContest.explorer && viewItem == autojudgeContest.problem",
          "group": "1_open@1"
        },
        {
          "command": "autojudgeContest.exportPublicCases",
          "when": "view == autojudgeContest.explorer && viewItem == autojudgeContest.problem",
          "group": "2_test@1"
        },
        {
          "command": "autojudgeContest.submitActiveFile",
          "when": "view == autojudgeContest.explorer && viewItem == autojudgeContest.problem",
          "group": "3_submit@1"
        },
        {
          "command": "autojudgeContest.openSubmission",
          "when": "view == autojudgeContest.explorer && viewItem =~ /^autojudgeContest\\.submission/",
          "group": "1_open@1"
        },
        {
          "command": "autojudgeContest.compareSubmissionOutput",
          "when": "view == autojudgeContest.explorer && viewItem == autojudgeContest.submission.output",
          "group": "inline@1"
        },
        {
          "command": "autojudgeContest.compareSubmissionOutput",
          "when": "view == autojudgeContest.explorer && viewItem == autojudgeContest.submission.output",
          "group": "1_open@2"
        },
        {
          "command": "autojudgeContest.openContestDashboard",
          "when": "view == autojudgeContest.explorer && viewItem == autojudgeContest.contest",
          "group": "1_open@1"
        },
        {
          "command": "autojudgeContest.openTeamStanding",
          "when": "view == autojudgeContest.teams && viewItem == autojudgeContest.standingTeam",
          "group": "inline@1"
        },
        {
          "command": "autojudgeContest.openTeamStanding",
          "when": "view == autojudgeContest.teams && viewItem == autojudgeContest.standingTeam",
          "group": "1_open@1"
        }
      ],
      "editor/title": [
        {
          "command": "autojudgeContest.submitActiveFile",
          "when": "autojudgeContest.state == loggedIn && resourceScheme == file && resourceExtname =~ /^\\.(c|cpp|java|js|php|py)$/i",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "autojudgeContest.openSubmission",
          "when": "false"
        },
        {
          "command": "autojudgeContest.openTeamStanding",
          "when": "false"
        },
        {
          "command": "autojudgeContest.compareSubmissionOutput",
          "when": "false"
        },
        {
          "command": "autojudgeContest.openProblem",
          "when": "autojudgeContest.state == loggedIn"
        },
        {
          "command": "autojudgeContest.exportPublicCases",
          "when": "autojudgeContest.state == loggedIn"
        },
        {
          "command": "autojudgeContest.submitActiveFile",
          "when": "autojudgeContest.state == loggedIn"
        },
        {
          "command": "autojudgeContest.openContestDashboard",
          "when": "autojudgeContest.state == loggedIn"
        },
        {
          "command": "autojudgeContest.logoutTeam",
          "when": "autojudgeContest.state == loggedIn"
        },
        {
          "command": "autojudgeContest.refreshTree",
          "when": "autojudgeContest.state != loggedOut"
        },
        {
          "command": "autojudgeContest.loginTeam",
          "when": "autojudgeContest.state != loggedIn"
        }
      ]
    },
    "configuration": {
      "title": "AutoJudge Contest",
      "properties": {
        "autojudgeContest.baseUrl": {
          "type": "string",
          "format": "uri",
          "default": "https://api.autojudge.io",
          "scope": "application",
          "order": 1,
          "markdownDescription": "Full AutoJudge API base URL used for contest problem browsing, submissions, and session hand-off. Defaults to `https://api.autojudge.io`."
        },
        "autojudgeContest.webUrl": {
          "type": "string",
          "format": "uri",
          "default": "https://autojudge.io",
          "scope": "application",
          "order": 2,
          "markdownDescription": "AutoJudge web app address opened in the browser to log in your team. Defaults to `https://autojudge.io`."
        },
        "autojudgeContest.pollIntervalMs": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "order": 3,
          "markdownDescription": "How often, in milliseconds, a submitted solution is checked for its verdict. Defaults to `5000`; the minimum is `1000`."
        },
        "autojudgeContest.confirmBeforeSubmit": {
          "type": "boolean",
          "default": true,
          "order": 4,
          "markdownDescription": "Ask for confirmation before submitting the active file, since a rejected attempt adds penalty time only if you solve that problem later. Unsaved files are always confirmed before they are saved and submitted."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.1",
    "vitest": "^4.1.7"
  }
}
